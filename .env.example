# Copia este archivo como ".env" en la raíz del proyecto y completa los valores.
# El archivo ".env" real NUNCA se sube a git (ver .gitignore).
# En Render, estas mismas variables se configuran en el dashboard: Environment > Add Environment Variable.

# API key de Brevo (Settings > SMTP & API > API Keys)
BREVO_API_KEY=

# Correo remitente verificado en Brevo (Senders, Domains & Dedicated IPs > Senders)
BREVO_SENDER_EMAIL=josex.developer@gmail.com

# URL pública donde corre la app (usada para armar el enlace de recuperación de clave)
# Local: http://localhost:8085
# Render: https://tu-servicio.onrender.com
APP_BASE_URL=http://localhost:8085
